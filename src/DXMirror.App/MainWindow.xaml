<Window x:Class="DXMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DXMirror.App.Views"
        Title="DXMirror" Width="1180" Height="780" MinWidth="880" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        Icon="pack://application:,,,/DXMirror;component/Assets/DXMirror.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="F11" Command="{Binding FullscreenCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== navigation ===== -->
        <Border x:Name="NavPane" Background="{DynamicResource Brush.Nav}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,20,24">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="&#xEC15;" Style="{StaticResource Text.Icon}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Brush.OnAccent}" />
                    </Border>
                    <TextBlock Text="DXMirror" FontSize="18" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Display}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="20,0,20,18" Style="{StaticResource Text.Secondary}" FontSize="12">
                    <Run Text="{DynamicResource S.Nav.Version}" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
                    <LineBreak /><Run Text="UxPlay" /> <Run Text="{Binding ReceiverVersion, Mode=OneWay}" />
                </TextBlock>
                <StackPanel>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" Checked="OnNavChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource S.Nav.Dashboard}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Checked="OnNavChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource S.Nav.Settings}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavItem}" GroupName="nav" Checked="OnNavChanged">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Text.Icon}" Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource S.Nav.Diagnostics}" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== pages ===== -->
        <Grid Grid.Column="1">
            <views:DashboardView x:Name="DashboardPage" />
            <views:SettingsView x:Name="SettingsPage" DataContext="{Binding SettingsPage}" Visibility="Collapsed" />
            <views:DiagnosticsView x:Name="DiagnosticsPage" Visibility="Collapsed" />

            <!-- short info message (4 s), placed at the top so the video window never covers it -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0" Padding="18,10"
                    CornerRadius="8" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" Panel.ZIndex="10" IsHitTestVisible="False"
                    Visibility="{Binding ShowToast, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Success}" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding ToastText}" FontSize="14" Foreground="{DynamicResource Brush.Text}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
