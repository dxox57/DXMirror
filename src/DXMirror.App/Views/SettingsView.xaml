<UserControl x:Class="DXMirror.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="Section" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource S.Nav.Settings}" Style="{StaticResource Text.Title}" Margin="0,0,0,8" />

        <TabControl Grid.Row="1">
            <!-- ================= General ================= -->
            <TabItem Header="{DynamicResource S.Tab.General}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Field.DeviceName}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Edit.DeviceName, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" Width="360" HorizontalAlignment="Left" />
                                <TextBlock Text="{DynamicResource S.Hint.DeviceName}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.Language}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Edit.Language}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.Theme}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Edit.Theme}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.StartWithWindows}" Content="{DynamicResource S.Opt.StartWithWindows}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.StartReceiverOnLaunch}" Content="{DynamicResource S.Opt.StartReceiverOnLaunch}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.MinimizeToTray}" Content="{DynamicResource S.Opt.MinimizeToTray}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.CloseToTray}" Content="{DynamicResource S.Opt.CloseToTray}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.NotificationsEnabled}" Content="{DynamicResource S.Opt.Notifications}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Connection ================= -->
            <TabItem Header="{DynamicResource S.Tab.Connection}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Field.Adapter}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{Binding AdapterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding AdapterSelection}" Width="460" HorizontalAlignment="Left" />
                                <TextBlock Text="{DynamicResource S.Hint.Adapter}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.PinEnabled}" Content="{DynamicResource S.Opt.Pin}" />
                                <TextBlock Text="{DynamicResource S.Hint.Pin}" Style="{StaticResource Hint}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsEnabled="{Binding Edit.PinEnabled}">
                                    <TextBlock Text="{DynamicResource S.Field.FixedPin}" Style="{StaticResource Text.Label}" />
                                    <TextBox Text="{Binding PinText, UpdateSourceTrigger=PropertyChanged}" Width="90" MaxLength="4" />
                                    <TextBlock Text="{Binding PinError}" Foreground="{DynamicResource Brush.Danger}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.RememberPinClients}" IsEnabled="{Binding Edit.PinEnabled}"
                                          Content="{DynamicResource S.Opt.RememberPin}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.NotifyOnConnect}" Content="{DynamicResource S.Opt.NotifyOnConnect}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.AutoReconnect}" Content="{DynamicResource S.Opt.AutoReconnect}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.NewClientTakesOver}" Content="{DynamicResource S.Opt.NewClientTakesOver}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.Timeout}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Edit.ConnectionTimeoutSeconds}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Video ================= -->
            <TabItem Header="{DynamicResource S.Tab.Video}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.MaxResolution}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Resolutions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding ResolutionSelection}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.MaxFps}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FrameRates}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding FpsSelection}" />
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Hint.Quality}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.HardwareAcceleration}" Content="{DynamicResource S.Opt.HardwareAcceleration}" />
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.Renderer}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Renderers}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Edit.VideoRenderer}" />
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.Scaling}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ScalingModes}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Edit.Scaling}" />
                                </Grid>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.EnableH265}" Content="{DynamicResource S.Opt.H265}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.EmbedVideo}" Content="{DynamicResource S.Opt.EmbedVideo}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.FullscreenOnConnect}" Content="{DynamicResource S.Opt.FullscreenOnConnect}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.AudioOnlyMode}" Content="{DynamicResource S.Opt.AudioOnly}" />
                                <TextBlock Text="{DynamicResource S.Hint.AudioOnly}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Field.RecordingFolder}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding RecordingFolderText, UpdateSourceTrigger=PropertyChanged}" Width="420" />
                                    <Button Content="{DynamicResource S.Action.Browse}" Command="{Binding BrowseRecordingFolderCommand}" Margin="8,0,0,0" />
                                    <Button Content="{DynamicResource S.Action.OpenFolder}" Command="{Binding OpenRecordingFolderCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource S.Hint.RecordingFolder}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Audio ================= -->
            <TabItem Header="{DynamicResource S.Tab.Audio}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Field.AudioDevice}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding AudioDevices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding AudioDeviceSelection}" Width="420" />
                                    <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" Command="{Binding RefreshDevicesCommand}"
                                            Margin="8,0,0,0" ToolTip="{DynamicResource S.Action.Refresh}" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource S.Hint.AudioDevice}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.AudioLatency}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Edit.AudioLatencyMs}" />
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Hint.AudioLatency}" Style="{StaticResource Hint}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.AvSyncEnabled}" Content="{DynamicResource S.Opt.AvSync}" />
                                <Grid Style="{StaticResource Row}" IsEnabled="{Binding Edit.AvSyncEnabled}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.AvOffset}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Text="{Binding Edit.AvSyncOffsetMs}" />
                                </Grid>
                                <TextBlock Text="{DynamicResource S.Hint.AvOffset}" Style="{StaticResource Hint}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.WasapiLowLatency}" Content="{DynamicResource S.Opt.LowLatency}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{DynamicResource S.Hint.VolumeOnDashboard}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================= Advanced ================= -->
            <TabItem Header="{DynamicResource S.Tab.Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource S.Field.LogLevel}" Style="{StaticResource Text.Body}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding Edit.LogLevel}" />
                                </Grid>
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Edit.DebugMode}" Content="{DynamicResource S.Opt.Debug}" />
                                <TextBlock Text="{DynamicResource S.Hint.Debug}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S.Field.CustomReceiver}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Edit.CustomUxPlayPath, TargetNullValue=''}" Width="460" HorizontalAlignment="Left" />
                                <TextBlock Text="{DynamicResource S.Hint.CustomReceiver}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Secondary}">
                                    <Run Text="{DynamicResource S.Field.DataFolder}" />: <Run Text="{Binding DataFolder, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,4,0,0">
                                    <Run Text="{DynamicResource S.Nav.Version}" /> <Run Text="{Binding AppVersion, Mode=OneWay}" /> · GPL-3.0 · UxPlay (GPL-3.0)
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ===== save bar ===== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource Button.Primary}" Command="{Binding SaveCommand}" Content="{DynamicResource S.Action.Save}" Margin="0,0,8,0" />
            <Button Command="{Binding RevertCommand}" Content="{DynamicResource S.Action.Revert}" Margin="0,0,8,0" />
            <Button Command="{Binding ResetDefaultsCommand}" Content="{DynamicResource S.Action.Defaults}" />
            <TextBlock Text="{Binding SaveMessage}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
