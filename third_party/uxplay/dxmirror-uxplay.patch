+/* ===== DXMirror integration (added by DXMirror build, GPL-3.0 like UxPlay) =====
+ * When DXMIRROR_EVENTS is set, machine-readable status lines "@@DXM <event> k=v ..."
+ * are written to stdout. When DXMIRROR_CONTROL is set (Windows), a line "quit" on
+ * stdin (or stdin being closed) triggers the same clean shutdown as Ctrl-C.
+ * DXMIRROR_HWND=<handle> lets GStreamer render into a window owned by DXMirror. */
+#include <atomic>
+#include <thread>
+#include <iostream>
+#include <string>
+static bool ab_enabled = false;
+static std::atomic<unsigned int> ab_frames{0};
+static std::atomic<unsigned long long> ab_video_bytes{0};
+static std::string ab_clean(const char *in) {
+    std::string out;
+    if (!in) return out;
+    for (const char *c = in; *c && out.size() < 96; c++) {
+        unsigned char u = (unsigned char) *c;
+        if (u < 0x20 || u == 0x7f) continue;
+        out += (*c == '"') ? '\'' : *c;
+    }
+    return out;
+}
+static void ab_event(const char *fmt, ...) {
+    if (!ab_enabled) return;
+    char buf[600];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    fprintf(stdout, "@@DXM %s\n", buf);
+    fflush(stdout);
+}
+/* DXMirror volume: the app's own volume factor (stdin "volume x", 0..1) multiplies the AirPlay
+ * client volume, so both the iPhone and DXMirror volume controls work. */
+static double ab_app_volume = 1.0;
+static double ab_client_gst_volume = 1.0;
+static gboolean ab_apply_volume(gpointer data) {
+    (void) data;
+    audio_renderer_set_volume(ab_client_gst_volume * ab_app_volume);
+    return G_SOURCE_REMOVE;
+}
+/* DXMirror recording (stdin "record_start <path-prefix>" / "record_stop").
+ * The iPhone sends a key frame (SPS+PPS+IDR) only at the start of a stream and on changes, so the
+ * frames since the last key frame are kept (bounded) to let a recording start at any moment. */
+#include <mutex>
+#include <vector>
+static std::mutex ab_mux_mutex;
+static bool ab_video_is_h265 = false;
+static bool ab_video_active = false;
+static bool ab_rec_waiting = false;           /* armed, waiting for the next key frame */
+static unsigned ab_last_w = 0, ab_last_h = 0;
+struct ab_frame { std::vector<unsigned char> data; uint64_t ntp; };
+static std::vector<ab_frame> ab_gop;
+static size_t ab_gop_bytes = 0;
+static bool ab_gop_valid = false;             /* buffer starts with a key frame */
+static const size_t AB_GOP_LIMIT = 96u * 1024u * 1024u;
+static std::string ab_record_prefix;
+
+static bool ab_is_keyframe(const unsigned char *d, int len) {
+    /* UxPlay delivers Annex-B access units; a key frame access unit starts with SPS (h264) / VPS (h265) */
+    if (len < 5 || d[0] != 0 || d[1] != 0 || d[2] != 0 || d[3] != 1) return false;
+    if (ab_video_is_h265) return ((d[4] >> 1) & 0x3f) == 32;
+    return (d[4] & 0x1f) == 7;
+}
+
+static void ab_gop_add(bool key, const unsigned char *d, int len, uint64_t ntp) {
+    if (key) {
+        ab_gop.clear();
+        ab_gop_bytes = 0;
+        ab_gop_valid = true;
+    }
+    if (!ab_gop_valid) return;
+    if (ab_gop_bytes + (size_t) len > AB_GOP_LIMIT) {
+        ab_gop.clear();
+        ab_gop_bytes = 0;
+        ab_gop_valid = false;     /* too long since the last key frame: wait for the next one */
+        return;
+    }
+    ab_gop.push_back(ab_frame{std::vector<unsigned char>(d, d + len), ntp});
+    ab_gop_bytes += (size_t) len;
+}
+
+/* ===== end DXMirror integration header ===== */
