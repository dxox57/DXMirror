+/* called with ab_mux_mutex held, on the GLib main loop */
+static void ab_record_start_locked() {
+    if (mux_to_file) return;
+    mux_filename = ab_record_prefix;
+    mux_renderer_init(render_logger, mux_filename.c_str(), use_audio, use_video);
+    mux_to_file = true;
