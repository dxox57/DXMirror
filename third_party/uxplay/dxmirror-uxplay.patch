+        ab_event("recording state=armed");
+    }
+}
+
+static void ab_record_stop_locked() {
+    if (!mux_to_file) return;
+    mux_renderer_stop();
+    mux_to_file = false;
+    ab_rec_waiting = false;
+    ab_event("recording state=stopped");
+}
+
+static gboolean ab_record_start_idle(gpointer data) {
+    (void) data;
+    std::lock_guard<std::mutex> lock(ab_mux_mutex);
+    ab_record_start_locked();
+    return G_SOURCE_REMOVE;
+}
+
+static gboolean ab_record_stop_idle(gpointer data) {
+    (void) data;
+    std::lock_guard<std::mutex> lock(ab_mux_mutex);
+    ab_record_stop_locked();
+    return G_SOURCE_REMOVE;
+}
+/* ===== end DXMirror recording control ===== */
